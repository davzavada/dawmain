# Nightly backup of the Vlastní zdroje database (deploy/web/backup-files.sh), started by
# dawmain-backup.timer. Enable as soon as /etc/dawmain/backup.env exists — preflight.sh
# requires it before the switch: until then it backs up the home instance's trial data,
# from the switch (phase 5, the database moves home) the users' data.
[Unit]
Description=Dawmain database backup (Vlastní zdroje)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/dawmain/backup.env

[Service]
Type=oneshot
# Runs as root: backup.env (owner URL, restic keys) is root-only.
ExecStart=/opt/dawmain-web/repo/deploy/web/backup-files.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# ProtectHome hides /root, so restic's cache lives in /var/cache/dawmain-backup
# (CacheDirectory creates it); the repository itself is remote.
CacheDirectory=dawmain-backup
# A repository on a locally mounted disk (instead of R2) lives under /backup or /var/backups;
# the password file belongs in /etc/dawmain/ (ProtectHome hides /root).
ReadWritePaths=-/backup -/var/backups
Environment=RESTIC_CACHE_DIR=/var/cache/dawmain-backup
