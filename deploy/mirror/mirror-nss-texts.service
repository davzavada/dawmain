# Daytime retry of the NSS texts the source did not return (fetch_queue, kind
# "text"), started by mirror-nss-texts.timer. vyhledavac.nssoud.cz answers the
# night run's text requests with its empty "N/A" page for documents it serves
# during the day: 4 904 decisions sat without text until a run at 17:20 got
# them (20. 11. 2026). `sync --source nss --days 1` retries the 500 rows due
# first and then re-reads the last day's publications, which costs little.
[Unit]
Description=Dawmain mirror: NSS texts, daytime retry
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mirror
Group=mirror
WorkingDirectory=/opt/dawmain
EnvironmentFile=/etc/mirror/env
Environment=NODE_ENV=production
ExecStart=/opt/dawmain/node_modules/.bin/tsx scripts/mirror.ts sync --source nss --days 1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/tmp
