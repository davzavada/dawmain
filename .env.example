# --- MCP endpoint auth -------------------------------------------------------
# Two methods, both optional, both accepted at once. On Vercel the endpoint
# fails closed: with NEITHER set, every request gets 401.
#
# (1) OAuth 2.1 via Clerk — the two standard Clerk keys (dashboard.clerk.com
# → Configure → API keys). MCP clients discover the login via
# /.well-known/oauth-protected-resource; the publishable key encodes the
# authorization-server domain, the secret key verifies OAuth access tokens.
# BOTH must be set for OAuth to activate. Setup: docs/development.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# (2) Shared access code — when set, requests may instead carry the token in:
#   Authorization: Bearer <MCP_BEARER_TOKEN>
#   X-API-Key: <MCP_BEARER_TOKEN>
#   cf-aig-authorization: <MCP_BEARER_TOKEN>
# (alternatives exist for connector UIs that reserve the Authorization
# header for OAuth). Kept as the fallback for existing connector configs.
MCP_BEARER_TOKEN=

# --- e-Sbírka ----------------------------------------------------------------
# Registered public REST API key (header esel-api-access-key). Without it the
# client falls back to the keyless SPA gateway.
ESBIRKA_API_KEY=
# Live-verified host (2026-08) is api.e-sbirka.gov.cz — already the code
# default, so this normally stays unset. The pre-migration api.e-sbirka.cz
# answers 200 with a non-JSON body. Re-verify via dawmain_probe_sources.
# ESBIRKA_API_BASE=https://api.e-sbirka.gov.cz

# --- EUIPO Guidelines (tools UNREGISTERED) -----------------------------------
# EUIPO's legal notices opt out of automated access, so the EUIPO tools are not
# exposed; these stay only for the dormant client in src/sources/.
# EUIPO_GUIDELINES_TM_PUB=2319054
# EUIPO_GUIDELINES_DESIGN_PUB=2231430

# --- Used by scripts/smoke.mjs ----------------------------------------------
# MCP_URL=https://<deployment>.vercel.app/api/mcp
# SMOKE_LIVE=1 to exercise real upstreams (works only where egress is open)
MCP_URL=
