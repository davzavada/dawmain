# --- MCP endpoint auth -------------------------------------------------------
# Two methods, both optional, both accepted at once. On Vercel the endpoint
# fails closed: with NEITHER set, every request gets 401.
#
# (1) OAuth 2.1 via Clerk — the two standard Clerk keys (dashboard.clerk.com
# → Configure → API keys). MCP clients discover the login via
# /.well-known/oauth-protected-resource; the publishable key encodes the
# authorization-server domain, the secret key verifies OAuth access tokens.
# BOTH must be set for OAuth to activate. Setup: docs/development.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# (2) Shared access code — when set, requests may instead carry the token in:
#   Authorization: Bearer <MCP_BEARER_TOKEN>
#   X-API-Key: <MCP_BEARER_TOKEN>
#   cf-aig-authorization: <MCP_BEARER_TOKEN>
# (alternatives exist for connector UIs that reserve the Authorization
# header for OAuth). Kept as the fallback for existing connector configs.
MCP_BEARER_TOKEN=

# --- e-Sbírka ----------------------------------------------------------------
# Registered public REST API key (header esel-api-access-key). Without it the
# client falls back to the keyless SPA gateway.
ESBIRKA_API_KEY=
# Live-verified host (2026-08) is api.e-sbirka.gov.cz — already the code
# default, so this normally stays unset. The pre-migration api.e-sbirka.cz
# answers 200 with a non-JSON body. Re-verify via dawmain_probe_sources.
# ESBIRKA_API_BASE=https://api.e-sbirka.gov.cz

# --- Vlastní zdroje (Pro) -----------------------------------------------------
# Neon Postgres Free (Frankfurt). Set these for PRODUCTION only; Preview keeps
# FILES_MODE unset (= off). Setup and the one-time SQL: docs/development.md.
#
# on | readonly | off (default off). Without FILES_DATABASE_URL the feature is
# "unconfigured" and every files_* tool answers that it is not available.
FILES_MODE=
# Pooled connection string of the dawmain_app role (NOT the owner: the app
# refuses a role that bypasses row-level security). There is no fallback to
# DATABASE_URL on purpose.
FILES_DATABASE_URL=
# Direct (unpooled) OWNER connection — used only by scripts/db-migrate.mjs,
# run by hand before a deploy. Never needed at runtime.
# DATABASE_URL_UNPOOLED=
# Clerk user ids (comma-separated) allowed on /vlastni-zdroje/provoz.
FILES_OPERATOR_IDS=
# Key for the opaque per-user id sent to AI Gateway for usage attribution
# (any long random string; falls back to CLERK_SECRET_KEY).
FILES_USER_HASH_SECRET=
# Metadata proposal model through Vercel AI Gateway. On Vercel the gateway
# authenticates with the deployment's OIDC token; locally set
# AI_GATEWAY_API_KEY. Without either, metadata come from heuristics only.
# FILES_META_MODEL=google/gemini-2.5-flash-lite
# AI_GATEWAY_API_KEY=
# Optional overrides (normovaných stran of 3 600 chars; AI budget in USD / 30 days).
# FILES_PERSONAL_PAGES=3000
# FILES_TEAM_PAGES=10000
# FILES_GLOBAL_MAX_PAGES=30000
# FILES_AI_BUDGET_USD=4
# Clerk webhook (user.deleted, organization.deleted, organizationMembership.*)
# → /api/webhooks/clerk. Signing secret from Clerk dashboard → Webhooks.
CLERK_WEBHOOK_SIGNING_SECRET=
# Vercel Cron (vercel.json, daily 03:00 UTC) sends it as a Bearer token to
# /api/cron/files. Any long random string.
CRON_SECRET=

# --- Used by scripts/smoke.mjs ----------------------------------------------
# MCP_URL=https://<deployment>.vercel.app/api/mcp
# SMOKE_LIVE=1 to exercise real upstreams (works only where egress is open)
MCP_URL=
