# Optional. When set, every request to /api/mcp must carry
#   Authorization: Bearer <MCP_BEARER_TOKEN>
# When unset, the endpoint is public — fine for local dev, not for a
# production deployment that exposes anything non-trivial.
MCP_BEARER_TOKEN=

# Used by scripts/smoke.mjs. Defaults to http://localhost:3000/api/mcp
MCP_URL=
