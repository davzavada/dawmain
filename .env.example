# --- MCP endpoint auth -------------------------------------------------------
# Two methods, both optional, both accepted at once. A production server
# (DAWMAIN_REQUIRE_AUTH, or NODE_ENV=production) fails closed: with NEITHER
# set, every request gets 401. Production uses Clerk only.
#
# (1) OAuth 2.1 via Clerk — the two standard Clerk keys (dashboard.clerk.com
# → Configure → API keys). MCP clients discover the login via
# /.well-known/oauth-protected-resource; the publishable key encodes the
# authorization-server domain, the secret key verifies OAuth access tokens.
# BOTH must be set for OAuth to activate. Setup: docs/development.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# (2) Shared access code — when set, requests may instead carry the token in:
#   Authorization: Bearer <MCP_BEARER_TOKEN>
#   X-API-Key: <MCP_BEARER_TOKEN>
#   cf-aig-authorization: <MCP_BEARER_TOKEN>
# (alternatives exist for connector UIs that reserve the Authorization
# header for OAuth). For local development and smoke tests; production does
# not set it.
MCP_BEARER_TOKEN=

# --- e-Sbírka ----------------------------------------------------------------
# Registered public REST API key (header esel-api-access-key). Without it the
# client falls back to the keyless SPA gateway.
ESBIRKA_API_KEY=
# Live-verified host (2026-08) is api.e-sbirka.gov.cz — already the code
# default, so this normally stays unset. The pre-migration api.e-sbirka.cz
# answers 200 with a non-JSON body. Re-verify via dawmain_probe_sources.
# ESBIRKA_API_BASE=https://api.e-sbirka.gov.cz

# --- Vlastní zdroje (Pro) -----------------------------------------------------
# PostgreSQL on the home server (database `files`, docs/infra/proxmox.md);
# locally any Postgres. Setup and the one-time SQL: docs/development.md.
#
# on | readonly | off (default off). Without FILES_DATABASE_URL the feature is
# "unconfigured" and every files_* tool answers that it is not available.
FILES_MODE=
# Connection string of the dawmain_app role (NOT the owner: the app
# refuses a role that bypasses row-level security). There is no fallback to
# DATABASE_URL on purpose.
FILES_DATABASE_URL=
# OWNER connection (files_owner) — used only by scripts/db-migrate.mjs,
# run by hand before a deploy. Never needed at runtime.
# DATABASE_URL_UNPOOLED=
# Clerk user ids (comma-separated) allowed on /vlastni-zdroje/provoz.
FILES_OPERATOR_IDS=
# Optional overrides (normovaných stran of 3 600 chars).
# FILES_PERSONAL_PAGES=10000
# FILES_TEAM_PAGES=10000
# FILES_GLOBAL_MAX_PAGES=30000
# Guards for the whole installation: uploads per day, and the feature's own
# CPU time (ms) per day and per rolling 30 days (sized for the former Vercel
# Hobby plan, not yet reviewed). Over them uploads get 429 and re-derivations wait.
# FILES_GLOBAL_UPLOADS_PER_DAY=200
# FILES_CPU_MS_DAY=600000
# FILES_CPU_MS_30D=3600000
# Clerk webhook (user.deleted, organization.deleted, organizationMembership.*)
# → /api/webhooks/clerk. Signing secret from Clerk dashboard → Webhooks.
CLERK_WEBHOOK_SIGNING_SECRET=
# dawmain-cron.service (daily, deploy/web/) sends it as a Bearer token to
# /api/cron/files. Any long random string.
CRON_SECRET=

# --- Zotero (Pro, čtení; ukládání nových položek jen v režimu „Číst a ukládat“) -
# OAuth aplikace Dawmainu na zotero.org: https://www.zotero.org/oauth/apps →
# registrace nové aplikace s callbackem https://<doména>/api/zotero/callback.
# Z detailu aplikace se sem opíše „Client Key“ a „Client Secret“. Callback
# posílá Dawmain podle adresy, na které uživatel právě je; když Zotero trvá na
# registrovaném callbacku, potřebuje jiná adresa (lokální nebo zkušební
# instance) vlastní aplikaci a vlastní dvojici hodnot. Bez obou hodnot, bez CREDENTIALS_SECRET nebo bez
# Clerku je Zotero na nasazení vypnuté: „Připojit Zotero“ vrátí „nedostupné“.
ZOTERO_OAUTH_CLIENT_KEY=
ZOTERO_OAUTH_CLIENT_SECRET=
# Tajemství, kterým se API klíče Zotera (a krátkodobá cookie připojování)
# zapečetí (AES-256-GCM), než jdou do privátních metadat v Clerku. Libovolný
# dlouhý náhodný řetězec (≥ 32 znaků; např. `openssl rand -base64 32`). Jeho
# změna uložené klíče znečitelní: uživatelé se připojí znovu a staré klíče
# zůstanou na zotero.org/settings/keys, dokud je tam sami nesmažou.
CREDENTIALS_SECRET=

# --- Used by scripts/smoke.mjs ----------------------------------------------
# MCP_URL=http://127.0.0.1:3000/api/mcp
# SMOKE_LIVE=1 to exercise real upstreams (works only where egress is open)
MCP_URL=

# --- Zrcadlo judikatury (home mirror) ----------------------------------------
# With URL + token set, the case-law tools (NS, NSS, ÚS, obecné soudy) read the
# home mirror for every account and fall back to the live court where the
# mirror cannot answer; without them everyone reads live. No per-account switch.
# On the home server the mirror is reached over the LAN
# (MIRROR_API_URL=http://192.168.0.52:8080, no Access pair); from elsewhere
# through the Cloudflare Tunnel behind Cloudflare Access (docs/infra/proxmox.md).
# MIRROR_API_URL=https://dawmain-databaze.davidzavada.cz
# MIRROR_API_TOKEN=
# Access service token (Zero Trust → Access → Service Auth), only through the tunnel.
# MIRROR_CF_ACCESS_CLIENT_ID=
# MIRROR_CF_ACCESS_CLIENT_SECRET=

# --- Server (Proxmox, deploy/web, docs/infra/proxmox.md) ---------------------
# What the production server sets in /etc/dawmain/env (src/runtime.ts). For
# `npm run dev` leave them unset.
#
# The production address — used for the "upload here" link, the MCP address
# on the home page and the OAuth discovery. A plain origin, no path.
# PUBLIC_URL=https://dawmain.davidzavada.cz
# What dawmain_ping reports: environment, region ("home"), commit. deploy.sh
# sets GIT_SHA itself.
# APP_ENV=production
# APP_REGION=home
# GIT_SHA=
# Refuse unauthenticated MCP requests even with no token and no Clerk
# configured. Fail-closed: only 0 / false / off / no turn it off; unset, a
# production server (NODE_ENV=production) requires auth anyway, `npm run dev`
# does not. The systemd unit sets it too.
# DAWMAIN_REQUIRE_AUTH=1
# Whether to take the site's address from X-Forwarded-Host / X-Forwarded-Proto.
# Off by default (any client can send those two; Cloudflare Tunnel passes the
# public Host itself). Turn on (1) only behind a proxy that overwrites them.
# The systemd unit pins 0.
# TRUST_FORWARDED_HOST=0
# One fixed key for Next's Server Functions (Správa: saving texts, switches), base64 of
# 32 bytes (`openssl rand -base64 32`), read at BUILD. Without it every build gets its own
# and a page left open across a deploy fails with "Failed to find Server Action".
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Build only (deploy.sh sets them): NEXT_OUTPUT=standalone makes
# .next/standalone/server.js; NEXT_DEPLOYMENT_ID is the release id for
# version-skew protection.

# Caps the own server raises (defaults are the former free-tier sizes): the
# database cap in MB and the estimated "compute hours" a month, which on an
# always-on own database should be set so high that it never trips.
# FILES_DB_CAP_MB=400
# FILES_COMPUTE_HOURS_PER_MONTH=100
